{
	"name": "dsh-nocturne",
	"version": "0.1.0",
	"description": "DSH 的夜书桌：把 Typewriter-Nocturne 的纸、灯与墨搬进浏览器——WebGL 双通道着色器渲染纸纹与辐照度，multiply 合成在界面之上，不含拟物打字机。",
	"license": "MIT",
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": {
			"default": "./lib/index.js"
		},
		"./client": {
			"default": "./lib/client.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"lib/index.js",
		"lib/client.js",
		"cordis.patch.yml",
		"README.md",
		"LICENSE"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [],
			"platform": "web",
			"immediately": true
		},
		"compat": {
			"dsh": ">=0.2.0 <0.3.0",
			"tested": "0.2.1-rc.3"
		}
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "^4.0.1"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/cordis": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=18"
	},
	"author": "dsh-nocturne contributors",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Chaosnap/Typewriter-Nocturne.git"
	},
	"keywords": [
		"deepseek",
		"deepseek-harness",
		"dsh",
		"dsh-plugin",
		"theme",
		"skin",
		"webgl",
		"parchment",
		"typewriter",
		"nocturne"
	],
	"scripts": {
		"build": "node tools/build.mjs",
		"pack": "node tools/build.mjs && npm pack"
	}
}
